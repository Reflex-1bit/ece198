<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patient Game Log</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'Segoe UI',Tahoma,Verdana,sans-serif;background:linear-gradient(135deg,#667eea,#764ba2);min-height:100vh;padding:20px}
        .container{max-width:1200px;margin:0 auto}
        .header{background:white;border-radius:15px;padding:30px;margin-bottom:20px;box-shadow:0 10px 30px rgba(0,0,0,0.2)}
        .patient-info{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
        .patient-name-input{font-size:28px;font-weight:bold;color:#333;border:2px solid transparent;border-radius:8px;padding:8px 12px;background:#f8f9fa;transition:.3s;width:100%;max-width:400px}
        .patient-name-input:hover{border-color:#667eea;background:white}
        .patient-name-input:focus{outline:none;border-color:#667eea;background:white;box-shadow:0 0 0 3px rgba(102,126,234,.1)}
        .session-date{color:#666;font-size:14px}
        .connection-status{display:flex;align-items:center;gap:10px;padding:15px;background:#e8f5e9;border-radius:10px;margin-bottom:20px}
        .status-indicator{width:12px;height:12px;border-radius:50%;background:#4caf50;animation:pulse 2s infinite}
        @keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
        .score-display{background:linear-gradient(135deg,#f093fb,#f5576c);border-radius:20px;padding:40px;text-align:center;color:white;box-shadow:0 10px 30px rgba(0,0,0,0.2)}
        .score-label{font-size:18px;opacity:.9;margin-bottom:10px;letter-spacing:2px}
        .score-value{font-size:72px;font-weight:bold;text-shadow:0 4px 10px rgba(0,0,0,.3)}
        .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:15px;margin-top:20px}
        .stat-card{background:white;border-radius:15px;padding:20px;box-shadow:0 5px 15px rgba(0,0,0,.1)}
        .stat-label{color:#666;font-size:14px;margin-bottom:8px}
        .stat-value{color:#333;font-size:32px;font-weight:bold}

        .tabs{display:flex;gap:10px;margin-top:20px}
        .tab-btn{padding:12px 24px;border-radius:8px;background:#f5f5f5;cursor:pointer;font-weight:600;transition:.3s}
        .tab-btn.active{background:#667eea;color:white}
        .tab-content{display:none}
        .tab-content.active{display:block}

        .log-section{background:white;border-radius:15px;padding:30px;margin-top:20px;box-shadow:0 10px 30px rgba(0,0,0,.2)}
        .log-title{font-size:24px;margin-bottom:20px;color:#333}
        .log-entry{padding:15px;border-left:4px solid #667eea;background:#f8f9fa;margin-bottom:10px;border-radius:5px}
        .log-time{color:#666;font-size:12px;margin-bottom:5px}
        button{padding:12px 24px;border:none;border-radius:8px;font-size:16px;cursor:pointer;font-weight:600;transition:.3s}
        .btn-primary{background:#667eea;color:white}
        .btn-secondary{background:#f5f5f5;color:#333}
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div class="patient-info">
            <div>
                <input type="text" class="patient-name-input" id="patientName" value="Patient Name">
                <div class="session-date" id="sessionDate">Session: Loading...</div>
            </div>
        </div>

        <div class="connection-status">
            <div class="status-indicator"></div><span>Arduino Connected (Simulated)</span>
        </div>

        <div class="score-display">
            <div class="score-label">Current Score</div>
            <div class="score-value" id="currentScore">0</div>
        </div>

        <div class="stats-grid">
            <div class="stat-card"><div class="stat-label">High Score</div><div class="stat-value" id="highScore">0</div></div>
            <div class="stat-card"><div class="stat-label">Games Played</div><div class="stat-value" id="gamesPlayed">0</div></div>
            <div class="stat-card"><div class="stat-label">Session Time</div><div class="stat-value" id="sessionTime">0:00</div></div>
        </div>

        <div class="controls">
            <button class="btn-primary" onclick="startDemo()">Start Demo Game</button>
            <button class="btn-secondary" onclick="resetScore()">Reset Score</button>
        </div>
    </div>

    <div class="tabs">
        <div class="tab-btn active" onclick="switchTab('logTab', this)">Activity Log</div>
        <div class="tab-btn" onclick="switchTab('storedTab', this)">Stored Scores</div>
    </div>

    <div id="logTab" class="tab-content active log-section">
        <div class="log-title">Activity Log</div>
        <div id="activityLog"></div>
    </div>

    <div id="storedTab" class="tab-content log-section">
        <div class="log-title">Stored Scores</div>
        <button class="btn-primary" onclick="storeCurrentScore()">Store Current Score</button>
        <div id="storedScores" style="margin-top:20px"></div>
    </div>
</div>

<script>
let storedScores = [];
let gameState = {
    score: 0,
    highScore: 0,
    gamesPlayed: 0,
    sessionStartTime: Date.now(),
    isPlaying: false
};

function switchTab(id, el) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    document.querySelectorAll('.tab-content').forEach(s => s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
}

function updateDateTime() {
    const now = new Date();
    document.getElementById('sessionDate').textContent =
        `Session: ${now.toLocaleDateString()} ${now.toLocaleTimeString()}`;
}
setInterval(updateDateTime, 1000);

function updateSessionTime() {
    const e = Math.floor((Date.now() - gameState.sessionStartTime) / 1000);
    document.getElementById('sessionTime').textContent =
        `${Math.floor(e / 60)}:${(e % 60).toString().padStart(2, '0')}`;
}
setInterval(updateSessionTime, 1000);

function updateScore(n) {
    gameState.score = n;
    document.getElementById('currentScore').textContent = n;

    if (n > gameState.highScore) {
        gameState.highScore = n;
        document.getElementById('highScore').textContent = n;
        addLogEntry(`New high score: ${n}!`);
    }
}

function startDemo() {
    if (gameState.isPlaying) return;

    gameState.isPlaying = true;
    gameState.score = 0;
    gameState.gamesPlayed++;
    document.getElementById('gamesPlayed').textContent = gameState.gamesPlayed;

    addLogEntry('Game started');

    let sim = setInterval(() => {
        if (Math.random() > 0.3)
            updateScore(gameState.score + Math.floor(Math.random() * 10) + 1);

        if (gameState.score > 100 || Math.random() > 0.95) {
            clearInterval(sim);
            gameState.isPlaying = false;
            addLogEntry(`Game ended. Final score: ${gameState.score}`);
        }
    }, 500);
}

function resetScore() {
    gameState.score = 0;
    updateScore(0);
    addLogEntry('Score reset');
}

function addLogEntry(msg) {
    const log = document.getElementById('activityLog');
    const e = document.createElement('div');
    e.className = 'log-entry';

    const t = new Date().toLocaleTimeString();
    e.innerHTML = `<div class='log-time'>${t}</div><div>${msg}</div>`;

    log.insertBefore(e, log.firstChild);

    while (log.children.length > 10)
        log.removeChild(log.lastChild);
}

function storeCurrentScore() {
    const name = document.getElementById('patientName').value || "Unknown Patient";
    const timestamp = new Date().toLocaleString();

    storedScores.push({
        name: name,
        score: gameState.score,
        timestamp: timestamp
    });

    updateStoredScores();

    addLogEntry(`Stored score: ${gameState.score} for ${name}`);
}

function updateStoredScores() {
    const c = document.getElementById('storedScores');
    c.innerHTML = "";

    storedScores.forEach((entry, i) => {
        const e = document.createElement('div');
        e.className = "log-entry";
        e.innerHTML = `
            <strong>Entry ${i + 1}</strong><br>
            Patient: ${entry.name}<br>
            Score: ${entry.score}<br>
            Time: ${entry.timestamp}
        `;
        c.appendChild(e);
    });
}

addLogEntry('System initialized');
</script>
</body>
</html>
